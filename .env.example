# Səhifəyə giriş açarı (URL-də ?s= parametri ilə eyni olmalıdır)
VITE_SANAN_KEY=your-secret-key-here

# Telegram bildirişləri üçün (bot token və chat ID)
# Bot token: @BotFather-dən alın
# Chat ID: bot-a /start edib https://api.telegram.org/bot<TOKEN>/getUpdates ilə tapın
VITE_TELEGRAM_BOT_TOKEN=your-bot-token-here
VITE_TELEGRAM_CHAT_ID=your-chat-id-here
